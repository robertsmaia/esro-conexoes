# Copie para .env (uso local) ou cadastre estas variáveis no Render → Environment.

# Banco Postgres do Supabase (Project Settings → Database → Connection string → "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Segredo do conector (mínimo 24 caracteres). Gere um aleatório, ex.: no PowerShell
#   -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
MCP_SECRET=

# ---------- WhatsApp ----------
# meta = Cloud API direto da Meta | 360dialog = número conectado pela 360dialog (coexistência)
WA_MODE=meta
# meta: token permanente de Usuário do Sistema | 360dialog: D360-API-KEY
WA_TOKEN=
# meta: "Phone number ID" (WhatsApp → Configuração da API). Não usado em 360dialog.
WA_PHONE_NUMBER_ID=
# meta: "Chave secreta do app" (Configurações do app → Básico). Deixe vazio em 360dialog.
WA_APP_SECRET=
# Qualquer frase sua; a mesma vai no campo "Verificar token" do webhook na Meta
WA_VERIFY_TOKEN=
GRAPH_VERSION=v23.0

# ---------- Instagram (API do Instagram com login do Instagram) ----------
IG_TOKEN=
IG_USER_ID=me
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_API_VERSION=v25.0

# ---------- Site ----------
# O checkout envia POST /webhooks/site com o cabeçalho x-esro-token igual a este valor
SITE_WEBHOOK_TOKEN=

# ---------- Painel administrativo (https://SEU-ENDERECO/painel) ----------
# Senha de entrada do painel: no mínimo 10 caracteres, longa e usada só aqui. Sem ela o painel fica desativado.
PAINEL_SENHA=
# Por quantos dias o navegador continua conectado depois do login (1 a 90)
PAINEL_SESSAO_DIAS=30

# ---------- Segurança (opcionais) ----------
# Certificado da autoridade do banco (Supabase → Project Settings → Database → SSL Configuration → Download certificate).
# Cole o conteúdo do arquivo .crt; com ele o servidor confere a identidade do banco antes de enviar qualquer dado.
DATABASE_CA_CERT=
# Apaga mensagens com mais de N dias (0 = nunca apaga)
RETENTION_DAYS=0
# Só para 360dialog, que não assina os webhooks: cadastre a URL do webhook com ?token=<este valor>
WA_WEBHOOK_TOKEN=
# Limites de proteção (padrões: 600 requisições por minuto por endereço; bloqueio de 15 min após 10 credenciais erradas)
RATE_LIMIT_PER_MINUTE=600
AUTH_FAILURES_LIMIT=10
